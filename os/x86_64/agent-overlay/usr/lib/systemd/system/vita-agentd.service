# Vita privileged system agent (agentd) — P1-026.
# Loopback-only control surface on 127.0.0.1:8786. Runs as root with exactly the two ambient
# capabilities it needs (netns/nft -> CAP_NET_ADMIN, sethostname -> CAP_SYS_ADMIN,
# clock_settime -> CAP_SYS_TIME). No
# privilege-separated user yet (a later hardening slice); the surface binds loopback only.
[Unit]
Description=Vita system agent
Documentation=https://vita.local/agent
# Loopback-only daemon (binds 127.0.0.1): deliberately NOT ordered after network-online.target — waiting on it
# hangs headless/no-NIC boots ~120s (systemd-networkd-wait-online times out), which blocked multi-user.

[Service]
Type=simple
ExecStart=/usr/lib/vita/agentd
Restart=on-failure
RestartSec=5s
# Route agentd's stdout/stderr to BOTH the journal and the console (= the serial console on the QEMU
# boot, -serial). Without this, agentd's witness markers — notably VITA-NODE-FIREWALL (the default-deny
# node firewall confirm) and the owner-identity / capsule witnesses — land only in the journal and never
# appear on the serial log the on-device boot verification scrapes. journal+console keeps the durable
# journal copy AND surfaces the markers on serial so the boot confirm can assert them.
StandardOutput=journal+console
StandardError=journal+console
# agentd still runs as UID 0, but its primary group owns /run/vita-agent and
# agentd.sock so the DynamicUser TS runtime can connect via SupplementaryGroups
# without making the privileged socket world-accessible.
Group=vita-agent
UMask=0007
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_TIME
StateDirectory=vita-agent
StateDirectoryMode=0700
RuntimeDirectory=vita-agent
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
