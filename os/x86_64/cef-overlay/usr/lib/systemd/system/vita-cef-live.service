# Vita SMOKE/VM only - CEF live-render arc (ADR-0014): INSTANT + PERSISTENT + INTERACTIVE desktop.
# Shows a BAKED first-frame snapshot of the flagship within ~2-5s of power-on, then CEF warms in
# the background and swaps to the live interactive render on the same surface; input (PSD-055) is
# wired through a reverse-channel FIFO + a visible cursor. Emits VITA-CEF + VITA-COMPOSITOR to
# serial. Verification-only overlay: not part of the production OS image.
[Unit]
Description=Vita CEF instant+live desktop -> compositor KMS scanout (interactive)
# FAST BOOT: start as EARLY as possible — only wait for udev (the DRM/vmwgfx + input devices) and
# the modules. Do NOT order after open-vm-tools or the compositor self-test: the self-test now
# yields the GPU immediately in CEF mode (no 30s hold), and open-vm-tools is only needed for the
# verification copy-out, not for rendering. This removes the ~31s serialization that delayed the
# desktop to ~42s; CEF now owns the GPU right after udev settles.
After=systemd-udev-trigger.service
Wants=systemd-udev-trigger.service

[Service]
# Long-lived: the script blocks in the foreground holding the live CEF->compositor pipe for
# the whole life of the powered-on VM. It reaches readiness (first GPU present + markers) well
# before it blocks, so a finite start timeout is unnecessary and would be wrong here.
Type=simple
ExecStart=/bin/bash /usr/lib/vita/cef/vita-cef-live.sh
TimeoutStartSec=infinity
# Fail-closed: if the live pipe dies (CEF crash, compositor exit), rebuild the desktop.
Restart=on-failure
RestartSec=2s
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
PrivateNetwork=yes
# NOTE (verification-only): PrivateTmp/ProtectHome/ProtectSystem are intentionally NOT set.
# Those mount-namespace protections give the service a PRIVATE /run; the CEF cache/home/logs
# under /run/vita-cef-* must live in the SHARED namespace (and any debug copy-out via vmtoolsd
# must be able to see them). This is a smoke/verification self-test (not the production OS), so
# /run is shared; the still-meaningful restrictions (NoNewPrivileges, capability bound, device
# allow-list, private network) remain. The production CEF capsule (PSD-056) is hardened separately.
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=char-drm rw
# PSD-055: libinput opens /dev/input/event* O_RDWR (grab/LED/feature writes), so the input
# devices need READ-WRITE here — char-input 'r' silently fails the open and disables the mouse.
DeviceAllow=char-input rw
DeviceAllow=/dev/tty0 rw
# Verification-only: the gated input self-test creates a virtual pointer via /dev/uinput.
DeviceAllow=/dev/uinput rw

[Install]
WantedBy=multi-user.target
