# Vita SMOKE/VM only - M4 of the CEF live-render arc (ADR-0014).
# Run CEF (windowless software OSR) rendering the LIVE flagship desktop, piped into the
# Vita native compositor on the real VMware GPU (KMS); emit VITA-CEF + VITA-COMPOSITOR
# to serial and a GPU-readback PNG to the shared /run for copy-out by vmware-verify.
# Verification-only overlay: not part of the production OS image.
[Unit]
Description=Vita CEF live-render -> compositor KMS readback (M4 verification)
After=systemd-modules-load.service systemd-udev-trigger.service open-vm-tools.service
Wants=systemd-udev-trigger.service open-vm-tools.service
# Run after the compositor self-test so only ONE process drives /dev/dri/card0 at a time
# (the KMS master is exclusive). The self-test is oneshot+RemainAfterExit, so After= here
# orders us strictly after it has released the device.
After=vita-compositor-selftest.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /usr/lib/vita/cef/vita-cef-live.sh
TimeoutStartSec=180s
StandardOutput=journal+console
StandardError=journal+console
NoNewPrivileges=yes
PrivateNetwork=yes
# NOTE (verification-only): PrivateTmp/ProtectHome/ProtectSystem are intentionally NOT set.
# Those mount-namespace protections give the service a PRIVATE /run, so the GPU-readback PNG
# written to /run/cef-live.png would be invisible to the global namespace and could not be
# copied out by vmtoolsd. This is a smoke/verification self-test (not the production OS), so
# /run is shared; the still-meaningful restrictions (NoNewPrivileges, capability bound, device
# allow-list, private network) remain. The production CEF capsule (PSD-056) is hardened separately.
CapabilityBoundingSet=CAP_SYS_TTY_CONFIG
AmbientCapabilities=
DevicePolicy=closed
DeviceAllow=char-drm rw
DeviceAllow=char-input r
DeviceAllow=/dev/tty0 rw

[Install]
WantedBy=multi-user.target
