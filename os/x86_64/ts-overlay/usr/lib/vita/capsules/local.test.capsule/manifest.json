{
  "id": "local.test.capsule",
  "version": "1.0.0",
  "integrity": "sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=",
  "packageClass": "ts-service",
  "runtime": {
    "typescript": {
      "entrypoint": "main.ts"
    }
  },
  "data": {
    "classes": ["app-state"],
    "volumes": [
      {
        "name": "state",
        "mountPath": "/var/lib/vita/runtime/volumes/state",
        "class": "app-state",
        "access": "read-write",
        "persistence": "persistent",
        "backup": true,
        "sizeMiB": 16
      }
    ]
  },
  "resourceLimits": {
    "cpuCores": 0.25,
    "ramMiB": 64,
    "storageMiB": 16,
    "tasksMax": 32
  }
}
