{
  "id": "local.wasm.capsule",
  "version": "1.0.0",
  "integrity": "sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=",
  "packageClass": "wasm-service",
  "runtime": {
    "wasm": {
      "module": "component.wasm"
    }
  },
  "resourceLimits": {
    "cpuCores": 0.25,
    "ramMiB": 64,
    "storageMiB": 16,
    "tasksMax": 32
  },
  "healthChecks": [
    {
      "name": "lifecycle",
      "type": "lifecycle",
      "target": "self",
      "intervalSeconds": 5,
      "timeoutSeconds": 2
    }
  ]
}
