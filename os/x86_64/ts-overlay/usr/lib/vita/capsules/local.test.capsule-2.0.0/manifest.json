{
  "id": "local.test.capsule",
  "version": "2.0.0",
  "integrity": "sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=",
  "packageClass": "ts-service",
  "runtime": {
    "typescript": {
      "entrypoint": "main.ts"
    }
  },
  "resourceLimits": {
    "cpuCores": 0.25,
    "ramMiB": 64,
    "storageMiB": 16,
    "tasksMax": 32
  },
  "data": {
    "classes": [
      "app-state"
    ],
    "volumes": [
      {
        "name": "state",
        "mountPath": "/var/lib/vita/runtime/volumes/local.test.capsule/state",
        "class": "app-state",
        "access": "read-write",
        "persistence": "persistent",
        "backup": false,
        "sizeMiB": 8
      }
    ]
  },
  "healthChecks": [
    {
      "name": "lifecycle",
      "type": "lifecycle",
      "target": "self",
      "intervalSeconds": 5,
      "timeoutSeconds": 2
    }
  ],
  "lifecyclePolicy": {
    "onUnhealthy": "fail"
  }
}
