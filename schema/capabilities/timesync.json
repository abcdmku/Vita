{
  "capability": "time.sync",
  "version": 1,
  "fields": {
    "enabled": {
      "required": true,
      "type": "boolean"
    },
    "servers": {
      "items": {
        "lowercase": true,
        "maxLength": 253,
        "noInlineSecrets": true,
        "pattern": "^(?![0-9]+(?:\\.[0-9]+){3}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
        "required": true,
        "type": "string"
      },
      "maxItems": 8,
      "required": true,
      "type": "array",
      "uniqueItems": true
    }
  },
  "crossFieldRules": [
    {
      "control": "enabled",
      "target": "servers",
      "type": "requireNonEmptyArrayWhenTrue"
    },
    {
      "control": "enabled",
      "target": "servers",
      "type": "requireEmptyArrayWhenFalse"
    }
  ]
}
