[
  {
    "name": "normal disabled accepts",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": "disabled"
      }
    },
    "expect": "accept"
  },
  {
    "name": "normal enabled accepts",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": "enabled"
      }
    },
    "expect": "accept"
  },
  {
    "name": "maintenance disabled accepts",
    "request": {
      "desired": {
        "mode": "maintenance",
        "remoteAccess": "disabled"
      }
    },
    "expect": "accept"
  },
  {
    "name": "maintenance enabled accepts",
    "request": {
      "desired": {
        "mode": "maintenance",
        "remoteAccess": "enabled"
      }
    },
    "expect": "accept"
  },
  {
    "name": "invalid mode rejects",
    "request": {
      "desired": {
        "mode": "reboot",
        "remoteAccess": "disabled"
      }
    },
    "expect": "reject",
    "rejectCode": "desired/mode"
  },
  {
    "name": "uppercase mode rejects",
    "request": {
      "desired": {
        "mode": "NORMAL",
        "remoteAccess": "disabled"
      }
    },
    "expect": "reject",
    "rejectCode": "desired/mode"
  },
  {
    "name": "invalid remoteAccess rejects",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": "ssh"
      }
    },
    "expect": "reject",
    "rejectCode": "desired/remoteAccess"
  },
  {
    "name": "non string remoteAccess rejects",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": true
      }
    },
    "expect": "reject",
    "rejectCode": "desired/remoteAccess"
  },
  {
    "name": "absent mode rejects",
    "request": {
      "desired": {
        "remoteAccess": "disabled"
      }
    },
    "expect": "reject",
    "rejectCode": "desired/mode"
  },
  {
    "name": "absent remoteAccess rejects",
    "request": {
      "desired": {
        "mode": "normal"
      }
    },
    "expect": "reject",
    "rejectCode": "desired/remoteAccess"
  },
  {
    "name": "unknown top-level key rejects",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": "disabled"
      },
      "extra": true
    },
    "expect": "reject",
    "rejectCode": "extra"
  },
  {
    "name": "unknown desired key rejects",
    "request": {
      "desired": {
        "mode": "normal",
        "remoteAccess": "disabled",
        "extra": true
      }
    },
    "expect": "reject",
    "rejectCode": "desired/extra"
  },
  {
    "name": "duplicate top-level desired key with valid final desired rejects",
    "request": "{\"desired\":{\"mode\":\"reboot\",\"remoteAccess\":\"disabled\"},\"desired\":{\"mode\":\"normal\",\"remoteAccess\":\"disabled\"}}",
    "expect": "reject"
  },
  {
    "name": "duplicate inner mode key with valid final mode rejects",
    "request": "{\"desired\":{\"mode\":\"reboot\",\"mode\":\"normal\",\"remoteAccess\":\"disabled\"}}",
    "expect": "reject"
  },
  {
    "name": "duplicate inner remoteAccess key with valid final remoteAccess rejects",
    "request": "{\"desired\":{\"mode\":\"normal\",\"remoteAccess\":\"ssh\",\"remoteAccess\":\"disabled\"}}",
    "expect": "reject"
  },
  {
    "name": "absent desired rejects",
    "request": {},
    "expect": "reject",
    "rejectCode": "desired"
  },
  {
    "name": "null desired rejects",
    "request": {
      "desired": null
    },
    "expect": "reject",
    "rejectCode": "desired"
  },
  {
    "name": "array desired rejects",
    "request": {
      "desired": []
    },
    "expect": "reject",
    "rejectCode": "desired"
  },
  {
    "name": "null request rejects",
    "request": null,
    "expect": "reject"
  },
  {
    "name": "array request rejects",
    "request": [],
    "expect": "reject"
  }
]
