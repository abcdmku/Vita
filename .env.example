# Worker (GPT-5.5 via Codex) configuration. Copy to .env (gitignored) only if you need overrides.
# This machine is already authenticated via `codex login` (ChatGPT subscription mode), so no key is
# required. Set OPENAI_API_KEY only to bill an API account instead.
# OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown; match ~/.codex/config.toml):
# VITA_WORKER_MODEL=gpt-5.5
# VITA_WORKER_EFFORT=xhigh
