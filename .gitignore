# dependencies
node_modules/
.pnpm-store/

# build output (anchored to repo root — `build/` unanchored swallowed tools/build/ source)
/build/
out/
**/dist/
*.tsbuildinfo
# agentd binary staged into the agent overlay by build-and-boot (a build artifact, not source)
os/x86_64/agent-overlay/usr/lib/vita/

# worker / loop runtime artifacts
.codex-output/
.vita-worktrees/
tools/loop/state/*.local.json
ai-factory/task-contracts/*.result.json
ai-factory/task-contracts/*.worker.md
ai-factory/task-contracts/*.review.md
ai-factory/task-contracts/*.review.json

# secrets — NEVER commit (spec §16 Security: keys unavailable to dev agents)
.env
.env.*
!.env.example
*.key
*.pem
secrets/
# Secure Boot TEST keystore (throwaway QEMU-demo PK/KEK/db + rogue pair). The *.key rule above
# catches db.key/rogue.key but NOT db.crt/rogue.crt or any staged .auth/.esl — anchor the whole
# dir so nothing in the keystore is ever trackable, regardless of extension. These are TEST-ONLY,
# per-host, never the production signing / N-of-M recovery keys (those are withheld from agents).
os/x86_64/.secureboot/

# os cruft
.DS_Store
Thumbs.db
desktop.ini
