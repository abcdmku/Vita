# dependencies
node_modules/
.pnpm-store/

# build output (anchored to repo root — `build/` unanchored swallowed tools/build/ source)
/build/
out/
**/dist/
*.tsbuildinfo
# agentd binary staged into the agent overlay by build-and-boot (a build artifact, not source)
os/x86_64/agent-overlay/usr/lib/vita/

# worker / loop runtime artifacts
.codex-output/
.vita-worktrees/
tools/loop/state/*.local.json
ai-factory/task-contracts/*.result.json
ai-factory/task-contracts/*.worker.md
ai-factory/task-contracts/*.review.md
ai-factory/task-contracts/*.review.json

# secrets — NEVER commit (spec §16 Security: keys unavailable to dev agents)
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# os cruft
.DS_Store
Thumbs.db
desktop.ini
