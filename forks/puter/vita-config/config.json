{
    "config_name": "vita-offline-single-owner",
    "env": "dev",
    "domain": "puter.localhost",
    "protocol": "http",
    "port": 4100,
    "pub_port": 4100,
    "database": { "engine": "sqlite", "path": "volatile/runtime/puter-database.sqlite" },
    "disable_temp_users": true,
    "captcha": { "enabled": false },
    "strict_email_verification_required": false,
    "providers": { "ollama": { "enabled": false } },
    "allow_all_host_values": true,
    "allow_no_host_header": true,
    "gui_puterjs_bundle": "/puter.js/v2/",
    "gui_params": {
        "title": "Vita",
        "short_description": "Vita — your secure personal computer",
        "social_media_image": ""
    }
}
